# --- LLM (required) ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=                        # a chat model id your API key can use
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=                 # when LLM_PROVIDER=openai (or RETRIEVAL_BACKEND=embeddings)

# --- Warehouse --------------------------------------------------------------------------------
# Read-only role created by db/init/03_readonly_role.sql (docker compose overrides the host).
WAREHOUSE_DSN=postgresql://analyst_ro:analyst_ro@localhost:5432/warehouse
AS_OF_DATE=2024-12-31             # the demo data ends here; unset to use the real current date

# --- Agent behaviour --------------------------------------------------------------------------
MAX_SQL_RETRIES=3                 # self-correction attempts after the first draft
REQUIRE_APPROVAL=true
APPROVAL_COST_THRESHOLD=20000     # EXPLAIN total cost above which a human must approve
STATEMENT_TIMEOUT_MS=15000
MAX_ROWS=1000
RETRIEVAL_BACKEND=tfidf           # tfidf (offline) | embeddings (needs OPENAI_API_KEY)
RETRIEVAL_TOP_K=3

# --- API --------------------------------------------------------------------------------------
API_KEY=                          # if set, clients must send it as X-API-Key

# --- LangSmith tracing (optional) -------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=text-to-sql-assistant
